on init
    chown system system /dev/cpu_dma_latency
    chmod 0664 /dev/cpu_dma_latency

on post-fs-data
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq
    chown system system /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/min_freq
    chown system system /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/max_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq
    chmod 0660 /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/min_freq
    chmod 0660 /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/max_freq

    chown system system /dev/blkio/blkio.weight
    chown system system /dev/blkio/background/blkio.weight
    chmod 0664 /dev/blkio/blkio.weight
    chmod 0664 /dev/blkio/background/blkio.weight

    chown system system /sys/devices/platform/soc/13000000.mali/hint_min_freq
    chmod 0664 /sys/devices/platform/soc/13000000.mali/hint_min_freq

    chown system system /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/governor
    chmod 0660 /sys/devices/platform/soc/13000000.mali/devfreq/13000000.mali/governor
